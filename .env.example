# NeonDB (Remote - Asset Database)
# Contains assets, endpoint_assets, server_assets, network_device_assets, affected_assets
NEON_DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# NvdDB (Local - CVE Database)
# Contains cve_records table with CVE JSON data from fkie-cad/nvd-json-data-feeds
NVD_DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=disable